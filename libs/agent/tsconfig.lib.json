{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": false,
        "tsBuildInfoFile": "./dist/tsconfig.lib.tsbuildinfo"
    },
    "include": ["src/**/*.ts"],
    "exclude": ["**/*.spec.ts", "**/*.test.ts", "**/__tests__/**"],
    "references": [
        {
            "path": "../engine/tsconfig.lib.json"
        },
        {
            "path": "../flows/tsconfig.lib.json"
        }
    ]
