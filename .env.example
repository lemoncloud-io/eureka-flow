# Eureka Flows Environment Configuration
# Copy this file to .env.local and fill in your values

# Required: API endpoint for the flows backend
VITE_API_URL=http://localhost:8800

# Optional: WebSocket endpoint for real-time updates
# VITE_WS_ENDPOINT=ws://localhost:8801

# Optional: Eureka Codes console URL for API key management
# VITE_CODES_URL=https://console.eureka.codes

# Optional: S3 bucket URL for i18n translations
# VITE_I18N_BUCKET_URL=https://your-bucket.s3.ap-northeast-2.amazonaws.com/i18n

# --- Flow-agent terminal (yarn agent:terminal) ---
# Model — the terminal talks DIRECTLY to Gemini (no browser, no backend proxy):
GEMINI_API_KEY=          # required for a live run; from Google AI Studio
# GEMINI_MODEL=gemini-2.5-flash
# LLM_RETRY_ATTEMPTS=4
# LLM_RETRY_BASE_MS=1000
# Connected mode (real blocks + flows, same as the browser):
# FLOW_API_URL=https://api.eureka.codes/flw-d1
# FLOW_API_KEY=          # dev-stage token; put the real value ONLY in .env.local (gitignored), never here
