# Web Application Environment Configuration
# Copy this file and rename to .env.local for local development

# Environment identifier (DEV, PROD, LOCAL)
VITE_ENV=LOCAL

# Project name
VITE_PROJECT=FLOWS

# API endpoint for the flows backend
VITE_API_URL=http://localhost:8800

# WebSocket endpoint for real-time updates
VITE_WS_ENDPOINT=ws://localhost:8801

# Backend API endpoint (if different from VITE_API_URL)
VITE_BACKEND_API_ENDPOINT=http://localhost:8800

# Eureka Codes console URL for API key management
VITE_CODES_URL=https://console.eureka.codes
