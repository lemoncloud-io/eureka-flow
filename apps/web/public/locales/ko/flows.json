        "gettingStarted": {
            "title": "FlowMosaic 시작하기",
            "intro": "FlowMosaic은 블록을 연결하여 자동화 워크플로우를 만드는 비주얼 에디터입니다. 각 블록은 특정 작업을 수행하며, 데이터는 한 블록에서 다음 블록으로 흐릅니다.",
            "steps": {
                "navigate": {
                    "title": "캔버스 탐색",
                    "description": "마우스 휠로 확대/축소하세요. 빈 공간을 클릭하고 드래그하여 이동할 수 있습니다. 하단의 줌 컨트롤을 사용하면 정밀하게 조절할 수 있습니다."
                },
                "addBlock": {
                    "title": "블록 추가",
                    "description": "왼쪽 라이브러리 버튼을 클릭하거나 사이드바를 눌러 사용 가능한 블록을 찾아보세요. 블록을 클릭하여 캔버스에 추가하거나, 드래그하여 원하는 위치에 놓을 수 있습니다."
                },
                "connect": {
                    "title": "블록 연결",
                    "description": "출력 포트(블록 오른쪽)에서 입력 포트(다른 블록 왼쪽)로 드래그하여 연결을 만드세요. 데이터는 이 연결을 통해 흐릅니다."
                },
                "configure": {
                    "title": "블록 설정",
                    "description": "블록을 클릭하여 선택하면 오른쪽에 상세 패널이 열립니다. 여기서 설정을 변경하고, 입력/출력을 확인하고, 자동 실행 같은 옵션을 설정할 수 있습니다."
                },
                "run": {
                    "title": "워크플로우 실행",
                    "description": "블록의 실행 버튼을 클릭하여 실행하거나, 헤더의 전체 실행 버튼을 사용하세요. 자동 실행이 활성화되어 있으면 모든 입력이 준비된 블록이 자동으로 실행됩니다."
                },
                "save": {
                    "title": "작업 저장",
                    "description": "Cmd/Ctrl + S를 눌러 저장하거나, 헤더에서 자동 저장을 활성화하세요. 워크플로우는 클라우드에 저장되어 어느 기기에서든 접근할 수 있습니다."
                },
                "publish": {
                    "title": "게시 및 공유",
