            },
            "welcome": {
                "title": "Let's explore the editor!",
                "description": "Your API key is set. Let's take a quick tour of the workflow editor. You can replay this tour anytime from the menu."
            },
            "sidebar": {
                "title": "Block Library",
                "description": "Click here to open the block library. Browse input, process, and output blocks, then drag or click to add them to your canvas."
            },
            "canvas": {
                "title": "Workflow Canvas",
                "description": "This is your workspace. Add blocks, connect them by dragging between ports, and build your automation flow. Scroll to zoom, drag empty space to pan."
            },
            "header": {
                "title": "Flow Info & Status",
                "description": "See your flow name, save status, and connection state. Click the name to rename your workflow."
            },
            "toolbar": {
                "title": "Quick Actions",
                "description": "Save, undo, redo, and open your flow list. These actions also have keyboard shortcuts for faster workflow."
            },
            "menu": {
