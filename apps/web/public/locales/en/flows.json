        "gettingStarted": {
            "title": "Getting Started with FlowMosaic",
            "intro": "FlowMosaic is a visual workflow editor that lets you build automation flows by connecting blocks. Each block performs a specific action, and data flows from one block to the next.",
            "steps": {
                "navigate": {
                    "title": "Navigate the Canvas",
                    "description": "Use mouse wheel to zoom in/out. Click and drag on empty space to pan. Use the zoom controls at the bottom for precise control."
                },
                "addBlock": {
                    "title": "Add Blocks",
                    "description": "Click the library button on the left or press the sidebar to browse available blocks. Click a block to add it to the canvas, or drag it to a specific position."
                },
                "connect": {
                    "title": "Connect Blocks",
                    "description": "Drag from an output port (right side of a block) to an input port (left side of another block) to create a connection. Data flows through these connections."
                },
                "configure": {
                    "title": "Configure Blocks",
                    "description": "Click a block to select it and open the detail panel on the right. Here you can configure settings, view inputs/outputs, and set options like auto-run."
                },
                "run": {
                    "title": "Run Your Workflow",
                    "description": "Click the Run button on a block to execute it, or use the Run All button in the header. Blocks with all inputs ready will execute automatically if auto-run is enabled."
                },
                "save": {
                    "title": "Save Your Work",
                    "description": "Press Cmd/Ctrl + S to save, or enable auto-save in the header. Your workflow is saved to the cloud and can be accessed from any device."
                }
            }
        },
